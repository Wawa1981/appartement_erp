# ===========================================
# Appartement ERP - Configuration (.env.example)
# Copier ce fichier vers .env et modifier les valeurs
# ===========================================

# --- Base de données PostgreSQL (utilisée par docker-compose) ---
POSTGRES_DB=appartement_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-me-in-production

# --- Django ---
SECRET_KEY=change-this-to-a-strong-random-secret-key
DEBUG=True

# --- Ports (pour éviter les conflits entre projets) ---
# Modifie ces valeurs si tu as des conflits de ports
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
# Ne pas utiliser 5173 (pris par eternalkidsart_web)
FRONTEND_HOST_PORT=5175

# Note importante :
# En mode Docker (recommandé), la DATABASE_URL est construite automatiquement
# dans docker-compose.yml pour pointer vers le service "db".
# Tu n'as normalement pas besoin de définir DATABASE_URL ici.
#
# Si tu veux tester en dehors de Docker (déconseillé pour l'instant) :
# DATABASE_URL=postgres://erp_user:change-me-in-production@localhost:5432/appartement_erp
