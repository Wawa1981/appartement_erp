# ===========================================
# L'Appartement ERP — .gitignore
# ===========================================

# --- Secrets & environnement ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials/

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
eggs/
develop-eggs/
parts/
sdist/
var/
wheels/
MANIFEST
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# Venv
venv/
.venv/
ENV/
env/
virtualenv/

# Django runtime
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# Coverage / tests
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
coverage.xml
*.cover
*.py,cover
nosetests.xml

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Builds Vite / tooling
dist/
dist-ssr/
.vite/
*.local
.turbo/
.cache/

# --- Docker ---
docker-compose.override.yml
docker-compose.*.local.yml

# --- IDE & OS ---
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Backups & temp ---
*.bak
*.bak.*
*.tmp
*.temp
*.cache
*.pid
*.seed
*.pid.lock
.~lock.*
*~

# --- Misc projet ---
# dumps SQL locaux (ne pas versionner de prod)
*.sql.gz
dump*.sql
!ScriptpostgreSQL

# fichiers d’export locaux
*.csv
!**/fixtures/**/*.csv
