# ===========================================
# Appartement ERP - .gitignore
# ===========================================

# --- Environnement & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
virtualenv/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Vite
dist/
.vite/

# --- Docker ---
docker-compose.override.yml

# --- IDE & OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Tests & Coverage ---
.coverage
htmlcov/
.tox/
.nox/
.pytest_cache/
coverage.xml
*.cover
*.py,cover

# --- Misc ---
*.bak
*.tmp
*.temp
*.cache
*.pid
*.seed
*.pid.lock

# Garder le dossier migrations mais ignorer les fichiers compilés
# (les migrations Python doivent être commités)
!**/migrations/__init__.py

.~lock.*
*~
